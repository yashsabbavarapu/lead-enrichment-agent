# ---------------------------------------------------------------------------
# Copy to .env and fill in what you have. Every value is OPTIONAL.
#   cp .env.example .env
#
# With an empty .env the agent still runs: `lea enrich "Vanta" --offline`
# works with no network and no keys. The keys below upgrade it.
# ---------------------------------------------------------------------------

# PLACEHOLDER -- a model key. FREE options exist; pick any ONE of these.
# Without one, the planner is a deterministic heuristic: the pipeline still runs
# end to end, but it does not reason, and it returns "unknown" more often on
# companies it has no recorded fixtures for.
#
# Free, no credit card. Google is the documented default.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=
#   https://console.groq.com/keys
GROQ_API_KEY=
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=
#   https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Paid, best output quality. Billed pay-as-you-go and SEPARATELY from a Claude
# Pro/Max subscription -- a subscription includes no API credits. Roughly $0.08
# per company on Sonnet 5. Wins over the free providers when both are set.
#   https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Override the auto-selected provider, model or endpoint.
#   LEA_LLM_PROVIDER=google|groq|openrouter|cerebras|ollama|anthropic|stub
LEA_LLM_PROVIDER=
LEA_MODEL=
# Point at any other OpenAI-compatible endpoint (self-hosted, LM Studio, a
# provider this build has never heard of). No code change needed.
LEA_LLM_BASE_URL=
LEA_LLM_API_KEY=

# PLACEHOLDER -- optional search upgrade, pick ONE.
# The keyless default (DuckDuckGo) works but gets bot-blocked under repeated
# use, which is exactly when you are demoing. Any key below removes that risk.
# Tavily has a free tier and is the best fit for agent search.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# PLACEHOLDER -- an email or URL you actually read.
# Sent in the User-Agent of every outbound request so site owners can reach you.
# Leave blank and the crawler is anonymous; setting it is the polite default.
LEA_CONTACT=

# --- Budgets per company (tune for cost vs. depth) -------------------------
LEA_MAX_STEPS=12
LEA_MAX_SEARCHES=5
LEA_MAX_FETCHES=6

# --- Demo / offline --------------------------------------------------------
# 1 = serve every HTTP call from examples/fixtures. Deterministic, no network.
# Equivalent to passing --offline. Use this when demoing on bad wifi.
LEA_OFFLINE=
