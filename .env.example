# All optional. The agent runs with zero keys (keyless DuckDuckGo search + stub brain).
# Adding ANTHROPIC_API_KEY is what turns it from a scripted demo into a real reasoning agent.

ANTHROPIC_API_KEY=
LEA_MODEL=claude-sonnet-5

# Optional upgraded search. Auto-selected if present, in this order.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Budgets
LEA_MAX_STEPS=12
LEA_MAX_SEARCHES=5
LEA_MAX_FETCHES=6

# Set to 1 to serve all HTTP from examples/fixtures (deterministic demo, no network)
LEA_OFFLINE=
